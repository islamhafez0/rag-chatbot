# All variables below are REQUIRED — the application will not function without them.
# Copy this file to .env and fill in every value.

GOOGLE_API_KEY=
ASTRA_DB_NAMESPACE=
ASTRA_DB_COLLECTION=
ASTRA_DB_API_ENDPOINT=
ASTRA_DB_APPLICATION_TOKEN=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# LLM provider (any OpenAI-compatible API, e.g. OpenCode Zen or Groq)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# LLM_MAX_TOKENS caps total output (reasoning + answer). deepseek-v4-flash-free reasons
# intermittently; keep it large so reasoning cannot starve the final answer.
LLM_MAX_TOKENS=4096
LLM_MAX_HISTORY_TURNS=12
LLM_TEMPERATURE=0.3

RETRIEVAL_LIMIT=8
EMBEDDING_MODEL=gemini-embedding-001

# Ingestion only (scripts/loadYaml.ts)
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
