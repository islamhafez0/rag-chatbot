# Copy to .env and fill in values. Names must match lib/env.ts exactly.
# Required — app refuses to boot without these (see validateEnv in lib/env.ts).

DATABASE_URL=
ASTRA_DB_COLLECTION=me_vectors
GOOGLE_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001

# LLM provider — Ollama Cloud (https://ollama.com/settings/keys)
LLM_BASE_URL=https://ollama.com/v1
LLM_API_KEY=
# gemma4:31b scored 47/48 on the answer eval at ~2.1s per answer (beam 47/48
# at ~4.7s; gpt-oss:120b and nemotron-3-super 45/48). See README > Evaluation.
LLM_MODEL=gemma4:31b

# Required numbers
RETRIEVAL_LIMIT=8
LLM_MAX_TOKENS=4096
LLM_MAX_HISTORY_TURNS=12
LLM_TEMPERATURE=0.3

# Optional — defaults apply when commented (see route.ts / generate.ts)
# MAX_MESSAGE_CHARS=2000
# MAX_MESSAGES=30
# MAX_HISTORY_CHARS=12000
# RATE_LIMIT_PER_MIN=20
# LLM_DISABLE_THINKING=false
# RETRIEVAL_SEARCH=vector     # vector (default, scored higher) | hybrid
# CONTEXT_BUDGET_CHARS=24000  # complete-mode context budget
# RETRIEVAL_LIMIT_EXPANDED=12

# Ingestion only (scripts/ingest_pgvector.ts, defaults shown)
# CHUNK_SIZE=2000
# CHUNK_OVERLAP=200
# INGEST_MIN_CHUNKS=10       # refuse to swap in a suspiciously small corpus

# Eval only (scripts/eval/harness.ts; defaults to RETRIEVAL_SEARCH)
# EVAL_SEARCH=vector
